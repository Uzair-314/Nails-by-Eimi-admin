# Copy to .env and fill in from your Supabase project settings.
# The publishable key is safe in client code — row level security is what
# protects the data, and every table here also requires an admin account.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the "View the shop" link points. Defaults to http://localhost:5173
VITE_SHOP_URL=
